PORT=5000
# For local demo without Atlas: leave MONGO_URI empty and set USE_LOCAL_MONGO=true
MONGO_URI=
USE_LOCAL_MONGO=true
# For real persistent DB: set your Atlas URI and set USE_LOCAL_MONGO=false (or remove it)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/interview_prep?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173
